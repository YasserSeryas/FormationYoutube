{
  "kind": "collectionType",
  "collectionName": "modules",
  "info": {
    "singularName": "module",
    "pluralName": "modules",
    "displayName": "Module",
    "description": "Module d'une formation"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
